#!/usr/bin/env python3
"""Local entry point for the xdev Linux mail endpoint."""

import os
from pathlib import Path
import sys


def run():
    args = sys.argv[1:]
    if args in ([], ["--help"], ["-h"]):
        print("xdev Linux Mail — messaging endpoint")
        print("Usage: ./xdev --version | who | msg --help")
        print("SSH pairing: use _rpc_mail with the fixed peer from your SSH configuration.")
        return 0
    if args[0] not in {"--version", "who", "msg", "_rpc_mail"}:
        print("Linux Mail supports who and msg. Use ./xdev --help.", file=sys.stderr)
        return 2
    if args[0] == "_rpc_mail" and len(args) != 2:
        print("SSH mail reception requires exactly one configured peer.", file=sys.stderr)
        return 2

    os.umask(0o077)
    sys.dont_write_bytecode = True
    sys.path.insert(0, str(Path(__file__).resolve().parent / "runtime"))
    from src.cli.main import main

    return main(args)


if __name__ == "__main__":
    raise SystemExit(run())
